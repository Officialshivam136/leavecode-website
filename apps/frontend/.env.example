# LeaveCode Frontend Production Environment Variables (.env.example)
# Copy to .env.local or configure in your SSR hosting platform (Vercel / AWS / Railway)
# NEVER commit real production secrets to source control.

# Canonical public domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://leavecode.com

# Express REST API endpoint
NEXT_PUBLIC_API_URL=https://api.leavecode.com/api/v1

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML Meta Tag Verification Token (optional if verified via DNS TXT)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
