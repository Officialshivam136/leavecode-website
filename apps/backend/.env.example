# LeaveCode Express Backend Production Environment Variables (.env.example)
# Copy to .env or configure in your API hosting platform (Render / Railway / AWS ECS)
# NEVER commit real production credentials to source control.

NODE_ENV=production
PORT=5000

# Comma-separated allowed CORS origins (strictly locked to canonical domain in production)
CORS_ORIGINS=https://leavecode.com,https://www.leavecode.com

# MongoDB Atlas Connection URI (Use TLS + SRV connection string with least-privilege DB user)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/leavecode_prod?retryWrites=true&w=majority

# Administrative Authentication Secrets (Generate 64-byte cryptographic random string for JWT_SECRET)
JWT_SECRET=replace_with_64_byte_cryptographic_random_secret
ADMIN_EMAIL=admin@leavecode.com
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# Transactional Email / SMTP Notification Provider (e.g., AWS SES, Resend, Postmark, SendGrid)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=replace_with_smtp_api_key
LEAD_ALERT_EMAIL=info@leavecode.com
