# ==============================================================================
# LEAVECODE ENTERPRISE ARCHITECTURE ENVIRONMENT CONFIGURATION
# Copy this file to .env or individual app .env files for local development.
# NEVER commit production secrets or credentials to version control.
# ==============================================================================

# Backend (Express API) Settings
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (MongoDB Atlas)
# Replace with your MongoDB Atlas connection string in local .env:
# e.g., mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/leavecode_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/leavecode_dev

# Frontend (Next.js) Public Variables
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
